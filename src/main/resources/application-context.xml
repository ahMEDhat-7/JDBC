<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">


    <!-- Load application.properties file -->
    <context:property-placeholder location="classpath:application.properties" />

    <!-- Create Database Bean -->
    <bean id="databaseOperations" class="org.example.config.DatabaseOperations">
        <property name="url" value="${database.url}"/>
        <property name="username" value="${database.username}"/>
        <property name="password" value="${database.password}"/>

    </bean>

    <!-- Create Circle Bean -->
    <bean id="circle" class="org.example.shapes.Circle" scope="singleton">
        <property name="radius" value="2" />
        <constructor-arg ref="databaseOperations" />

    </bean>
    <bean id="connectToDbCircle" class="org.example.shapes.Circle" init-method="connectToDb" />
    <bean id="disconnectToDbCircle" class="org.example.shapes.Circle" destroy-method="disconnectToDb" />



    <!-- Create Square Bean -->
    <bean id="square" class="org.example.shapes.Square">
        <property name="databaseOperations" ref="databaseOperations"/>
        <property name="side" value="2" />
    </bean>
    <bean id="connectToDbSquare" class="org.example.shapes.Square" init-method="connectToDb" />
    <bean id="disconnectToDbSquare" class="org.example.shapes.Square" destroy-method="disconnectToDb" />


    <!-- Create DrawShape Bean -->
    <bean id="drawShape" class="org.example.shapes.DrawShapes">
    </bean>

</beans>

